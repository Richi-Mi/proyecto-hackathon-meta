NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://smart:smart@localhost:5432/smart_abarrotes
DB_LOGGING=false

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32+
JWT_EXPIRES_IN_SECONDS=28800

# Secreto del QR de entrada (distinto a JWT_SECRET, mínimo 32 caracteres) y su vigencia
ENTRY_PASS_SECRET=cambia-este-secreto-del-pase-de-entrada-32+
ENTRY_PASS_TTL_SECONDS=60

# Orígenes del frontend separados por coma
CORS_ORIGINS=http://localhost:5173

# Trazas → OTel Collector (docker compose) → Jaeger en http://localhost:16686
OTEL_ENABLED=true
OTEL_SERVICE_NAME=smart-abarrotes-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Usado solo por `bun run db:seed`
SEED_OWNER_NAME=Propietario
SEED_OWNER_EMAIL=owner@smart-abarrotes.mx
SEED_OWNER_PASSWORD=cambia-esta-contraseña
SEED_DEMO_CATALOG=true
SEED_CUSTOMER_NAME=Cliente Demo
SEED_CUSTOMER_EMAIL=cliente@smart-abarrotes.mx
SEED_CUSTOMER_PASSWORD=cambia-esta-contraseña
# ~40 ventas de los últimos 14 días (solo si la base no tiene ventas)
SEED_DEMO_SALES=true
